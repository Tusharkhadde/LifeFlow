generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id
  name            String?
  email           String          @unique
  emailVerified   Boolean         @default(false)
  image           String?
  language        String          @default("en")
  username        String?         @unique
  displayUsername String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  knowledgeItems  KnowledgeItem[]
  telegramLinks   TelegramLink[]
  linkCodes       LinkCode[]
  conversations   Conversation[]
  personalMemories PersonalMemory[]
  tasks           Task[]
  reminders       Reminder[]
  pendingActions  PendingAction[]
  contextEntities ContextEntity[]
  contextRelations ContextRelation[]
  sessions        Session[]
  accounts        Account[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TelegramLink {
  id             String   @id @default(uuid())
  userId         String
  telegramUserId BigInt   @unique
  telegramChatId BigInt?
  telegramName   String?
  preferredModel String?
  lastBriefingAt DateTime?
  linkedAt       DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LinkCode {
  id        String   @id @default(uuid())
  userId    String
  code      String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id             String              @id @default(uuid())
  userId         String
  telegramChatId BigInt
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       ConversationMessage[]

  @@unique([userId, telegramChatId])
  @@index([userId, updatedAt])
}

model ConversationMessage {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String       @db.Text
  telegramMessageId Int?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, telegramMessageId])
  @@index([conversationId, createdAt])
}

model PersonalMemory {
  id         String   @id @default(uuid())
  userId     String
  key        String
  value      String   @db.Text
  category   String   @default("general")
  confidence Float    @default(0.8)
  source     String?
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, archived, updatedAt])
}

model Task {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?   @db.Text
  dueAt       DateTime?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed, dueAt])
}

model Reminder {
  id         String    @id @default(uuid())
  userId     String
  text       String
  remindAt   DateTime
  completed  Boolean   @default(false)
  lastNotifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed, remindAt])
}

model PendingAction {
  id             String   @id @default(uuid())
  userId         String
  telegramChatId BigInt
  action         String
  payload        Json
  source         String   @db.Text
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, telegramChatId])
  @@index([expiresAt])
}

model ContextEntity {
  id          String            @id @default(uuid())
  userId      String
  name        String
  normalized  String
  type        String            @default("concept")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoing    ContextRelation[] @relation("fromEntity")
  incoming    ContextRelation[] @relation("toEntity")

  @@unique([userId, normalized])
  @@index([userId, updatedAt])
}

model ContextRelation {
  id           String        @id @default(uuid())
  userId       String
  fromEntityId String
  toEntityId   String
  relation     String
  source       String?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromEntity   ContextEntity @relation("fromEntity", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity     ContextEntity @relation("toEntity", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@unique([fromEntityId, toEntityId, relation])
  @@index([userId, createdAt])
}

model KnowledgeItem {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String?  @db.Text
  summary   String?  @db.Text
  aiMemory  String?  @db.Text
  type      String   @default("link") // "link" | "note" | "document" | "audio"
  sourceUrl String?
  favicon   String?
  category  String   @default("general")
  tags      Json? // Array of string tags (e.g. ["react", "ui", "components"])
  favorite  Boolean  @default(false)
  archived  Boolean  @default(false)
  metadata  Json? // Additional scraped or parsed details
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
