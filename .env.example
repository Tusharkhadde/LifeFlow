DATABASE_URL="postgresql://user:password@localhost:5432/lifeflow?sslmode=require"

# Better Auth (see src/lib/auth.ts)
BETTER_AUTH_SECRET="generate-a-random-32-character-secret"
BETTER_AUTH_URL="http://localhost:3000"
INTEGRATION_OAUTH_SECRET="generate-an-independent-random-32-character-secret"
# Encrypts OAuth and webhook credentials at rest. Keep stable; rotation needs re-encryption.
TOKEN_ENCRYPTION_KEY="generate-a-random-32-character-secret"
# Comma-separated browser origins allowed to call /api/v1 (Chrome extensions are allowed explicitly)
ALLOWED_API_ORIGINS="http://localhost:3000"

# OAuth (optional — used for sign-in and Google Calendar integration)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_CALENDAR_CLIENT_ID=""   # optional override; falls back to GOOGLE_CLIENT_ID
# GOOGLE_CALENDAR_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Notion integration (https://www.notion.so/my-integrations — OAuth tab)
# NOTION_CLIENT_ID=""
# NOTION_CLIENT_SECRET=""
# Redirect URI: {BETTER_AUTH_URL}/api/integrations/notion/callback
# Google Calendar redirect URI: {BETTER_AUTH_URL}/api/integrations/google-calendar/callback

# Gmail (read-only inbox scan). Enable Gmail API in Google Cloud; falls back to GOOGLE_CLIENT_ID/SECRET
# GMAIL_CLIENT_ID=""
# GMAIL_CLIENT_SECRET=""
# Gmail redirect URI: {BETTER_AUTH_URL}/api/integrations/gmail/callback

# Optional: transcription model for meeting audio / Telegram voice notes
# OPENAI_TRANSCRIPTION_MODEL="whisper-1"
# TTS_MODEL="tts-1"

# TokenRouter / OpenRouter AI API (OpenAI-compatible)
OPENAI_API_KEY="sk-your-tokenrouter-api-key"
OPENAI_BASE_URL="https://api.tokenrouter.com/v1"
OPENAI_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"
# Cheap model for classification, extraction, and graph linking
# OPENAI_FAST_MODEL="openai/gpt-4o-mini"
# Used once if the primary model request fails
# OPENAI_FALLBACK_MODEL="openai/gpt-4o-mini"
# USD per million tokens when the provider does not return usage.cost
# AI_INPUT_COST_PER_MILLION_USD="0.15"
# AI_OUTPUT_COST_PER_MILLION_USD="0.60"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Exa.ai Web Search (required for Telegram smart search)
EXA_API_KEY="your-exa-api-key"

# Hugging Face Inference Providers (takes priority when HF_* is set)
# HF_API_KEY="hf_your_token"
# HF_BASE_URL="https://router.huggingface.co/v1"
# HF_MODEL="Qwen/Qwen2.5-7B-Instruct"
# HF_TRANSCRIPTION_MODEL="openai/whisper-large-v3-turbo"

# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_WEBHOOK_SECRET="generate-a-random-32-character-secret"
CRON_SECRET="generate-a-random-cron-secret"

# Optional observability
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""
